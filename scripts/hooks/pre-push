#!/usr/bin/env bash
# A branch push builds the image for the checked-out commit and uploads it.
set -euo pipefail

if [[ "${C1_PUBLISHING:-}" == 1 ]]; then
    exit 0
fi

root=$(git rev-parse --show-toplevel)
head=$(git rev-parse HEAD)
publish=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$remote_ref" == refs/heads/* ]] || continue
    [[ "$local_sha" == 0000000000000000000000000000000000000000 ]] && continue
    if [[ "$local_sha" != "$head" ]]; then
        echo "Refusing to push ${remote_ref}: the image is built from the checked-out commit." >&2
        exit 1
    fi
    publish=1
done

if [[ "$publish" == 1 ]]; then
    export C1_PUBLISHING=1
    "$root/scripts/publish.sh"
fi
