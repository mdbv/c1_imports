# SFTP settings
SFTP_HOST=sftp.example.com
SFTP_USER=username
SFTP_PASS=password
SFTP_PORT=22
SFTP_REMOTE_DIR=.

# Where mirrored files and the download history database live
LOCAL_DIR=/app/files
STATE_DIR=/app/state
LOG_DIR=/var/log

# Cron schedule in UTC. Default 1:00 PM UTC.
CRON_MINUTE=0
CRON_HOUR=13
CRON_DOM=*
CRON_MONTH=*
CRON_DOW=*

# Public URL of this app, as reached through the reverse proxy.
BASE_URL=https://c1.example.com
# openssl rand -hex 32
SESSION_SECRET=change-me

# Entra ID app registration
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Object ID of the security group whose members may use the app
ENTRA_GROUP_ID=
